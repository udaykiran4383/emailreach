# --- EmailReach connection (required for every mode) ---
# URL of the running EmailReach Next.js app. In Docker use http://host.docker.internal:3000
EMAILREACH_URL=http://localhost:3000
# Must match CRON_SECRET in the EmailReach app's .env.local
CRON_SECRET=change-me
# How often to run a background tick (seconds, min 10). EmailReach enforces its own
# daily limits, send windows and random delays, so this only sets the polling rate.
EMAILREACH_TICK_SECONDS=60

# --- General ---
NODE_ENV=development
LOG_LEVEL=info

# --- Full mode only (scheduler + workers) ---
# Scheduler HTTP API port (avoid 3000, which Next.js uses)
PORT=3101
ETCD_HOSTS=localhost:2379
KAFKA_BROKERS=localhost:9092
REDIS_URL=redis://localhost:6379
PROMETHEUS_PORT=9090
