{
  "name": "emailreach-scheduler",
  "version": "1.0.0",
  "private": true,
  "description": "Chronos job scheduler driving EmailReach background sending (vendored from udaykiran4383/chronos-job-scheduler)",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/scheduler/index.js",
    "worker": "node dist/worker/index.js",
    "lite": "tsx src/lite.ts",
    "start:lite": "node dist/lite.js",
    "dev:scheduler": "tsx watch src/scheduler/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "dev:infra": "docker compose -f deploy/docker-compose.yml up",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "etcd3": "^1.1.2",
    "express": "^4.18.2",
    "kafkajs": "^2.2.4",
    "prom-client": "^15.0.0",
    "redis": "^4.6.5",
    "uuid": "^9.0.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.5",
    "@types/uuid": "^9.0.2",
    "tsx": "^4.7.0",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
